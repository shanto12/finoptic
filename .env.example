# Copy to .env and adjust. All variables are optional — FinOptic runs fully offline with sane defaults.

# --- Core ---
FINOPTIC_ENVIRONMENT=development
FINOPTIC_DEBUG=false
FINOPTIC_DATABASE_URL=sqlite:///./finoptic.db

# --- API security (optional) ---
# When require_auth is true, requests must send: X-API-Key: <one-of-the-keys>
FINOPTIC_REQUIRE_AUTH=false
FINOPTIC_API_KEYS=dev-key-1,dev-key-2
FINOPTIC_RATE_LIMIT_PER_MINUTE=120

# --- GenAI / LLM (optional) ---
# Provider auto-detects from standard env vars if left as "auto".
# Supported: none | anthropic | openai | azure-openai | auto
FINOPTIC_LLM_PROVIDER=auto
# Either set FINOPTIC_LLM_API_KEY explicitly, or rely on the standard provider envs below.
# FINOPTIC_LLM_API_KEY=
# FINOPTIC_LLM_MODEL=claude-sonnet-4-6
# FINOPTIC_LLM_BASE_URL=

# Standard provider envs (auto-detected when FINOPTIC_LLM_PROVIDER=auto):
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
